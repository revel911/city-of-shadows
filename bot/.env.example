# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# DeepSeek
DEEPSEEK_API_KEY=
# DeepSeek-V4.1-Flash; keep in sync with narrator evaluations.
DEEPSEEK_MODEL=deepseek-flash

# GitHub (game state)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=city-of-shadows
GITHUB_BRANCH=main

# Optional: post one-line session summaries to a #world-events channel
WORLD_EVENTS_CHANNEL_ID=

# Optional: compaction tuning (defaults shown)
# COMPACT_AT — message-count threshold to trigger summarization
# KEEP_RECENT — turns kept verbatim at the tail after a compaction
COMPACT_AT=30
KEEP_RECENT=8

# Private transcript archive (never the public game repository)
ARCHIVE_GITHUB_OWNER=
ARCHIVE_GITHUB_REPO=
ARCHIVE_GITHUB_TOKEN=
ARCHIVE_GITHUB_BRANCH=main
# Use a persistent Fly volume in production; keep local spool outside Git.
ARCHIVE_SPOOL_DIR=.archive-spool
# Live-session snapshots for restart resume (transcripts stay private here).
# Unset disables snapshots; production uses /data/runtime on the Fly volume.
RUNTIME_DIR=.runtime
